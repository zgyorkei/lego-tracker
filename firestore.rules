rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && 
        incoming().keys().hasAll(['uid', 'email']) &&
        incoming().uid == userId &&
        incoming().email is string &&
        incoming().email.size() < 256;
      allow update: if isOwner(userId) && 
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']);
    }

    // Per-user settings (currently the price-source list).
    //
    // Private to the owner. Rules cannot iterate a list, so the sources are
    // validated as a container (type and a cap matching the server's
    // MAX_SOURCES) rather than per entry; the server re-validates every source
    // it is asked to fetch. Because the shape check is generic, adding or
    // editing a source never needs a rules change.
    match /userSettings/{userId} {
      function isValidSettings(data) {
        return data.keys().hasOnly(['priceSources', 'updatedAt']) &&
               data.priceSources is list && data.priceSources.size() <= 15 &&
               data.updatedAt is string && data.updatedAt.size() <= 40;
      }

      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidSettings(incoming());
      allow delete: if isOwner(userId);
    }

    // Sets collection
    match /sets/{setId} {
      function isValidSet(data) {
        return data.userId == request.auth.uid &&
               data.setNumber is string && data.setNumber.size() <= 20 &&
               data.status in ['planned', 'ordered'] &&
               data.priority in ['low', 'medium', 'high'] &&
               (data.name == null || (data.name is string && data.name.size() <= 200));
      }

      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() && isValidSet(incoming()) && 
        incoming().createdAt == request.time;
        
      allow update: if isSignedIn() && isOwner(existing().userId) && isValidSet(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          // Action: General Update
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'priority', 'orderedDate', 'orderedPriceHuf', 'orderedOriginalPrice', 'orderedCurrency', 'name', 'productImage', 'legoPriceHuf', 'legoUrl', 'isTemporary', 'releaseDate', 'hasFetchedLegoInfo', 'lastLegoPriceRefreshTime', 'marketPrices', 'lastPricesRefreshTime', 'legoPriceError', 'updatedAt', 'quantity', 'minifigures', 'minifiguresStatus'])
        );
        
      allow delete: if isSignedIn() && isOwner(existing().userId);

      // Price History subcollection.
      //
      // This is now read back by the price-history chart, so the payload is
      // shape-checked rather than accepting any document that happens to carry
      // a 'date' string. Keys beyond those listed are rejected; the per-source
      // price fields are validated by the numeric sweep in isValidHistory.
      function ownsParentSet() {
        return isSignedIn() &&
          get(/databases/$(database)/documents/sets/$(setId)).data.userId == request.auth.uid;
      }

      // Each source contributes two columns ('<id>Price' and '<id>PriceHuf'),
      // plus date, exchangeRate and createdAt, so the cap allows for the
      // 15-source server limit with headroom.
      function isValidHistory(data) {
        return data.date is string &&
               data.date.size() <= 32 &&
               (!('exchangeRate' in data.keys()) || data.exchangeRate is number) &&
               data.keys().size() <= 64;
      }

      match /priceHistory/{priceId} {
        allow read: if ownsParentSet();
        allow create: if ownsParentSet() &&
          incoming().keys().hasAll(['date']) &&
          isValidHistory(incoming());
        allow delete: if ownsParentSet();
      }
    }

    // Planned lists collection
    //
    // A published snapshot of every planned set, served to other
    // applications by GET /api/planned-sets/:token. The server has no
    // Firestore credentials and reads this doc unauthenticated over the REST
    // API, so public get is required. The doc id is a random token and is
    // the only access control, same as a registry link. The client writes an
    // explicit per-set field whitelist (src/lib/plannedList.ts); never spread
    // a LegoSet into it.
    match /plannedLists/{listId} {
      function isValidPlannedList(data) {
        return data.keys().hasOnly(['userId', 'title', 'sets', 'createdAt', 'updatedAt']) &&
               data.title is string && data.title.size() <= 200 &&
               data.sets is list && data.sets.size() <= 1000 &&
               data.createdAt is string && data.createdAt.size() <= 40 &&
               data.updatedAt is string && data.updatedAt.size() <= 40;
      }

      allow get: if true;
      allow list: if isOwner(resource.data.userId);
      allow create: if isOwner(incoming().userId) &&
        isValidId(listId) && listId.size() >= 16 &&
        isValidPlannedList(incoming());
      allow update: if isOwner(existing().userId) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        isValidPlannedList(incoming());
      allow delete: if isOwner(existing().userId);
    }

    // Registries collection
    //
    // Public read is intentional and is the whole point of the feature: a
    // registry link is handed to gift recipients, who must be able to open it
    // without an account. Writes stay owner-only.
    match /registries/{registryId} {
      allow get: if true;
      allow list: if isOwner(resource.data.userId);
      allow create: if isOwner(incoming().userId);
      // Only the existing owner may update, and userId is pinned. The previous
      // '|| isOwner(incoming().userId)' let any signed-in link holder set
      // userId to their own uid and take the registry over, after which the
      // delete rule below passed for them too.
      allow update: if isOwner(existing().userId) &&
        incoming().userId == existing().userId;
      allow delete: if isOwner(existing().userId);

      match /reservations/{setId} {
        // Anyone with the registry link can see what's already reserved.
        allow read: if true;

        // First reservation wins: a reservation can be created only if one does
        // not already exist for this set (create == resource is null), and the
        // payload is shape-validated. This matches the client UX where an
        // overwrite attempt surfaces "maybe someone else just got it".
        allow create: if incoming().keys().hasOnly(['setId', 'reservedBy', 'createdAt']) &&
          incoming().setId == setId &&
          incoming().reservedBy is string &&
          incoming().reservedBy.size() > 0 &&
          incoming().reservedBy.size() <= 100 &&
          incoming().createdAt is string &&
          incoming().createdAt.size() <= 40;

        // No overwriting an existing reservation by visitors.
        allow update: if false;

        // Only the registry owner may clear/manage reservations.
        allow delete: if isOwner(get(/databases/$(database)/documents/registries/$(registryId)).data.userId);
      }
    }
  }
}
